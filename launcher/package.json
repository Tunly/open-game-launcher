{
  "name": "open-game-launcher",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12 <26"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "build:budget": "pnpm build && pnpm bundle:check",
    "preview": "vite preview",
    "prepare": "node scripts/prepare-husky.mjs",
    "tauri": "tauri",
    "supabase": "supabase --workdir ..",
    "supabase:migration:list": "supabase --workdir .. migration list",
    "supabase:migration:new": "supabase --workdir .. migration new",
    "supabase:db:push": "supabase --workdir .. db push",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\" \"*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\" \"*.{ts,tsx,js,json,md}\"",
    "test": "vitest run",
    "test:e2e:desktop": "node --test --test-timeout=300000 e2e/desktop-smoke.test.mjs",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint-staged": "lint-staged --cwd .. --config ../lint-staged.config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "~2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.9",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "selenium-webdriver": "4.50.0",
    "supabase": "2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "4.1.9"
  }
}
