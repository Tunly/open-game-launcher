{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Game Launcher",
  "version": "0.1.0",
  "identifier": "com.opengamelauncher.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "OG-Launcher startet",
        "url": "splashscreen.html",
        "width": 480,
        "height": 250,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "main",
        "title": "Open Game Launcher",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**/*",
            "$APPLOCALDATA/**/*",
            "$APPCACHE/**/*",
            "$HOME/**/*",
            "C:/Program Files (x86)/Steam/appcache/librarycache/**/*",
            "C:/Program Files/Steam/appcache/librarycache/**/*",
            "C:/Program Files (x86)/Steam/steam/games/**/*",
            "C:/Program Files/Steam/steam/games/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["oglauncher"]
      }
    }
  }
}
