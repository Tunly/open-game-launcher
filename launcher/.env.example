VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional. Leave empty to disable the client CAPTCHA. For local UI tests only,
# Cloudflare's always-pass public test key is: 1x00000000000000000000AA
# Configure the matching secret only in Supabase Auth; never expose it as VITE_*.
VITE_TURNSTILE_SITE_KEY=
# Must be an exact Supabase Auth redirect allow-list URL in hosted deployments.
# Local default when empty: the current launcher origin plus /auth.
VITE_AUTH_REDIRECT_URL=
VITE_OG_TRUSTED_INGESTION_STRICT=
VITE_INVITE_FALLBACK_ORIGIN=
OGL_LICENSE_VERIFYING_KEY=
