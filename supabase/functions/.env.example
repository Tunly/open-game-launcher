# Supabase Edge Functions — environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit a real `.env` file — it is in `.gitignore`.

# --- Shared -------------------------------------------------------------
# Project URL of the Supabase instance. Public, safe to commit individually.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service-role key. SERVER-ONLY — never expose to the client.
# Obtain from Supabase Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Anon key, used for verifying the caller's JWT. Safe per-row, but mark as
# server-only because we trust the result.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# --- stripe-create-checkout -------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
SUCCESS_URL=https://open-game-launcher.example/store/success
CANCEL_URL=https://open-game-launcher.example/store/cart

# --- notify-price-drop -------------------------------------------------
RESEND_API_KEY=re_REPLACE_ME
PRICE_DROP_FROM_EMAIL=price-alerts@open-game-launcher.example

# --- rawg-assets --------------------------------------------------------
RAWG_API_KEY=REPLACE_ME
