# Supabase Edge Functions — environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit a real `.env` file — it is in `.gitignore`.

# --- Shared -------------------------------------------------------------
# Project URL of the Supabase instance. Public, safe to commit individually.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service-role key. SERVER-ONLY — never expose to the client.
# Obtain from Supabase Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Anon key, used for verifying the caller's JWT. Safe per-row, but mark as
# server-only because we trust the result.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# --- community-artwork-moderation -------------------------------------
# Uses SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY.
# Add reviewers to private.community_artwork_moderators before live review.

# --- stripe-create-checkout -------------------------------------------
# Local examples use test-mode values. The `store-stripe-live` external
# completion gate requires live Stripe env (`sk_live_...` plus `whsec_...`) and
# redacted live Dashboard/webhook evidence collected outside this file.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Required for production signed offline license tokens. Use an Ed25519 private
# seed in base64url or hex format.
# Do not paste this key into external evidence artifacts; prove custody with a
# redacted runtime-secret locator and live license issuance locator instead.
OGL_LICENSE_SIGNING_KEY=REPLACE_WITH_ED25519_PRIVATE_SEED
# Local/staging only. Never enable this in production; generated keys fail
# offline validation and are labeled OGL-STAGING-UNSIGNED-*.
OGL_LICENSE_ALLOW_UNSIGNED_FALLBACK=false

# --- ingest-achievements ----------------------------------------------
# Optional server-only attestation secret for a separately reviewed trusted
# relay. relay-steam-achievements is deliberately keyless/local-only and does
# not use this value. Minimum length: 32 characters.
ACHIEVEMENT_INGESTION_ATTESTATION_SECRET=replace-with-random-attestation-secret-min32

# --- notify-price-drop -------------------------------------------------
# Use a high-entropy random value with 32+ characters.
PRICE_DROP_NOTIFY_SECRET=replace-with-random-cron-secret-min32

# --- poll-platform-presence -------------------------------------------
# Use a high-entropy random value with 32+ characters.
PRESENCE_POLL_SECRET=replace-with-random-cron-secret-min32
PRESENCE_POLL_CADENCE_SECONDS=60
PRESENCE_POLL_MAX_BATCH=100
PRESENCE_POLL_TIMEOUT_MS=8000
# Steam presence is an independent lane and still uses this provider key.
STEAM_WEB_API_KEY=REPLACE_ME
PRESENCE_PROVIDER_TOKEN=REPLACE_ME
EPIC_PRESENCE_ENDPOINT=https://bridge.example/epic
GOG_PRESENCE_ENDPOINT=https://bridge.example/gog
EA_PRESENCE_ENDPOINT=https://bridge.example/ea
XBOX_PRESENCE_ENDPOINT=https://bridge.example/xbox
BATTLENET_PRESENCE_ENDPOINT=https://bridge.example/battlenet
UBISOFT_PRESENCE_ENDPOINT=https://bridge.example/ubisoft

# --- process-account-deletions ----------------------------------------
# Use a high-entropy random value with 32+ characters.
ACCOUNT_DELETION_PROCESSOR_SECRET=replace-with-random-cron-secret-min32

# --- invite-hosted-proof ----------------------------------------------
INVITE_HOSTED_PROOF_ALLOWED_ORIGINS=https://open-game-launcher.example

# --- store-download-build ---------------------------------------------
STORE_BUILDS_BUCKET=store-builds

# --- rawg-assets --------------------------------------------------------
RAWG_API_KEY=REPLACE_ME
RAWG_ASSETS_ALLOWED_ORIGINS=https://open-game-launcher.example

# --- Hosted deploy gate CI/runtime ------------------------------------
# GitHub Environment secrets/vars used by scripts/hosted-deploy-gate.mjs.
SUPABASE_ACCESS_TOKEN=sbp_REPLACE_ME
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1
OGL_HOSTED_DEPLOY_FUNCTIONS=
OGL_HOSTED_SMOKE_ORIGIN=https://open-game-launcher.example

# --- Hosted cron evidence collector -----------------------------------
# Operator-only local shell variables for scripts/hosted-cron-evidence.mjs.
SUPABASE_REST_URL=https://YOUR-PROJECT-REF.supabase.co/rest/v1
# Must be an authenticated caller JWT for the same hosted Supabase project when
# paired with SUPABASE_ANON_KEY; anon-role JWTs are rejected.
SUPABASE_AUTH_JWT=REPLACE_WITH_CALLER_JWT
# Operator-only inputs for the redacted, non-mutating hosted Steam relay probe.
# The game id is a catalog UUID and the Steam AppID must match that mapping.
OGL_STEAM_RELAY_GAME_ID=REPLACE_WITH_CATALOG_GAME_UUID
OGL_STEAM_RELAY_STEAM_APP_ID=REPLACE_WITH_MATCHING_STEAM_APP_ID
# Optional local diagnostics: uncomment to override all lane defaults; leaving
# this disabled keeps the stricter presence-poll 15 minute default. The
# release-boundary completion gate scrubs this override.
# OGL_HOSTED_CRON_FRESHNESS_HOURS=
OGL_HOSTED_CRON_EVIDENCE_CHECKS=

# --- External completion evidence preflight ---------------------------
# Operator-only local shell variables for scripts/external-evidence-check.mjs.
OGL_EXTERNAL_EVIDENCE_GATES=
# Optional local diagnostics only; the release-boundary completion gate scrubs
# this override and uses the current clock.
OGL_EXTERNAL_EVIDENCE_NOW=
