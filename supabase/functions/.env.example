[TEMPLATE]
# Supabase Edge Functions — environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit a real `.env` file — it is in `.gitignore`.

# --- Shared -------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_ANON_KEY=REPLACE_ME

# --- Achievements -------------------------------------------------------
ACHIEVEMENT_INGESTION_ATTESTATION_SECRET=replace-with-random-attestation-secret-min32

# --- poll-platform-presence -------------------------------------------
PRESENCE_POLL_SECRET=replace-with-random-cron-secret-min32
PRESENCE_POLL_CADENCE_SECONDS=60
PRESENCE_POLL_MAX_BATCH=100
PRESENCE_POLL_TIMEOUT_MS=8000
STEAM_WEB_API_KEY=REPLACE_ME
PRESENCE_PROVIDER_TOKEN=REPLACE_ME
EPIC_PRESENCE_ENDPOINT=https://bridge.example/epic
GOG_PRESENCE_ENDPOINT=https://bridge.example/gog
EA_PRESENCE_ENDPOINT=https://bridge.example/ea
XBOX_PRESENCE_ENDPOINT=https://bridge.example/xbox
BATTLENET_PRESENCE_ENDPOINT=https://bridge.example/battlenet
UBISOFT_PRESENCE_ENDPOINT=https://bridge.example/ubisoft

# --- process-account-deletions ----------------------------------------
ACCOUNT_DELETION_PROCESSOR_SECRET=replace-with-random-cron-secret-min32

# --- invite-hosted-proof ----------------------------------------------
INVITE_HOSTED_PROOF_ALLOWED_ORIGINS=https://open-game-launcher.example

# --- IGDB metadata ------------------------------------------------------
# Create a confidential Twitch Developer application for IGDB.
IGDB_CLIENT_ID=REPLACE_ME
IGDB_CLIENT_SECRET=REPLACE_ME

# --- ITAD price data ----------------------------------------------------
ITAD_API_KEY=REPLACE_ME

# --- Hosted deploy gate CI/runtime ------------------------------------
SUPABASE_ACCESS_TOKEN=REPLACE_ME
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1
OGL_HOSTED_DEPLOY_FUNCTIONS=
OGL_HOSTED_SMOKE_ORIGIN=https://open-game-launcher.example

# --- Hosted cron evidence collector -----------------------------------
SUPABASE_REST_URL=https://YOUR-PROJECT-REF.supabase.co/rest/v1
SUPABASE_AUTH_JWT=REPLACE_ME # authenticated caller JWT
OGL_STEAM_RELAY_GAME_ID=REPLACE_WITH_CATALOG_GAME_UUID
OGL_STEAM_RELAY_STEAM_APP_ID=REPLACE_WITH_MATCHING_STEAM_APP_ID
OGL_HOSTED_CRON_EVIDENCE_CHECKS=
# OGL_HOSTED_CRON_FRESHNESS_HOURS=

# --- License signing (hosted release boundary) ------------------------
OGL_LICENSE_SIGNING_KEY=REPLACE_ME

# --- External completion evidence preflight ---------------------------
OGL_EXTERNAL_EVIDENCE_GATES=
OGL_EXTERNAL_EVIDENCE_NOW=
